# =============================================================================
# Velo (github.com/ybreakless/Velo) — Official .gitignore
# =============================================================================

# 1. Rust & Cargo Build Artifacts
/target/
**/*.rs.bk
*.pdb
Cargo.lock.bak

# 2. Velo Partial Transfers, Resume State & Local Test Media
*.velo.part
*.velo.json
*.velo.tmp
*.torrent
*.m3u8
*.mpd
*.ts
*.m4s
*.mp4
*.mkv
*.webm
*.iso
/downloads/
/tmp-downloads/

# 3. Privacy, Proxy, WireGuard & Local Credentials (Never Commit)
.env
.env.*
!.env.example
*.conf
*.wg
*.ovpn
*.pem
*.key
cookies.txt
cookies.sqlite

# 4. OpenCode & AI Agent Local Scratch / Session State
.opencode/
.claude/
.cursor/
*.log

# 5. Cross-Platform Packaging & Coverage Artifacts (Tauri / Tarpaulin / LLVM)
/dist/
/bundle/
lcov.info
profraw/
*.profraw
*.profdata
tarpaulin-report.html

# 6. Operating System & Editor Files
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
Desktop.ini
.vscode/
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.iml
*.swp
*.swo
*~
